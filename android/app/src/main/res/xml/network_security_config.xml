<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, trusting only the system's built-in certificate authorities
     (user-installed certificates are ignored, which blocks most
     traffic-interception setups). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
